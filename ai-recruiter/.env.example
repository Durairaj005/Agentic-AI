# Application Environment Configuration
APP_NAME="AI-Powered Smart Recruitment & Candidate Matching Platform"
ENVIRONMENT="development"
DEBUG=True

# JWT Authentication
SECRET_KEY="smart-recruiter-super-secure-production-jwt-secret-key-32-chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (SQLite by default, or PostgreSQL)
DATABASE_URL="sqlite:///./recruitment.db"
# DATABASE_URL="postgresql://user:password@localhost:5432/recruitment_db"

# CORS Configuration (JSON-encoded array)
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://localhost:8000"]

# Local Embedding Model (Sentence-Transformers)
EMBEDDING_MODEL_NAME="all-MiniLM-L6-v2"
FAISS_INDEX_PATH="./storage/faiss_indexes/candidates.index"

# Upload Directories
UPLOAD_DIR="./storage/uploads"
