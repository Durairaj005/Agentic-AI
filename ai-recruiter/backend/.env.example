# Application Configuration
APP_NAME="AI Smart Recruitment Platform"
APP_ENV="development"
DEBUG=True
API_V1_STR="/api/v1"
SECRET_KEY="super-secret-jwt-recruitment-platform-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (SQLite default for zero-config local run; PostgreSQL ready)
DATABASE_URL="sqlite:///./recruitment.db"

# Storage Directories
UPLOAD_DIR="./storage/resumes"
FAISS_INDEX_DIR="./storage/faiss_indexes"

# AI & NLP Configuration
EMBEDDING_MODEL_NAME="sentence-transformers/all-MiniLM-L6-v2"
ENABLE_OLLAMA=False
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3"

# CORS Allowed Origins
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]
