# ──────────────────────────────────────────────────
#  AI Data Analyst Agent — Environment Variables
#
#  INSTRUCTIONS:
#  1. Copy this file to .env
#     cp .env.example .env
#  2. Fill in your actual values in .env
#  3. NEVER commit .env to git
# ──────────────────────────────────────────────────

# ── LLM Provider (Phase 2+) ──────────────────────
# Get your key from: https://aistudio.google.com/
LLM_PROVIDER=groq
LLM_API_KEY=your_groq_api_key_here
LLM_MODEL=openai/gpt-oss-120b

# ── Tavily Web Research (Phase 9+) ───────────────
# Get your key from: https://tavily.com/
TAVILY_API_KEY=your_tavily_api_key_here

# ── Database (Phase 6+) ──────────────────────────
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=analyst_user
MYSQL_PASSWORD=your_strong_password_here
MYSQL_DATABASE=ai_data_analyst

# ── Redis Cache (Phase 7+) ───────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ── FastAPI Application (Phase 5+) ───────────────
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=generate_a_long_random_secret_key_here

# ── JWT Authentication (Phase 10+) ───────────────
JWT_SECRET_KEY=generate_another_long_random_secret_here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── File Upload Settings (Phase 5+) ──────────────
MAX_UPLOAD_SIZE_MB=50
UPLOAD_DIR=./uploads

# ── Logging ──────────────────────────────────────
LOG_LEVEL=INFO
